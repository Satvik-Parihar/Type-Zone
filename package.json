{
  "name": "typezone",
  "version": "1.0.0",
  "description": "Production-grade MERN TypeZone workspace",
  "scripts": {
    "test": "npm --prefix server run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "start": "npm --prefix server run start",
    "dev": "node dev-start.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "eslint \"client/src/**/*.{js,jsx}\" \"server/src/**/*.js\"",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satvik-Parihar/Type-Zone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Satvik-Parihar/Type-Zone/issues"
  },
  "homepage": "https://github.com/Satvik-Parihar/Type-Zone#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.6"
  },
  "private": true,
  "workspaces": [
    "client",
    "server"
  ]
}
